<?xml version="1.0" encoding="utf-8"?>
<sprites>
	<!-- Top Panel -->
	<sprite name="topPanel">
		<image
			texture="editor/ribbon_bg.png"
			real_texture_placement="0 0 2048 32"
			size="0 0 100% 100%"
		/>

		<!-- sides -->
		<image
			texture="editor/border/line_horiz.png"
			texture_size="0 0 64 4"
			size="4 0 100%-4 4"
		/>
		<image
			texture="editor/border/line_horiz.png"
			texture_size="0 0 64 4"
			size="4 100%-4 100%-4 100%"
		/>
	</sprite>

	<!-- Left Paint Panel -->
	<sprite name="leftPaintPanel">
		<!-- background -->
		<image backcolor = "12 12 12"/>
		<image texture = "global/modern/background.png"
			texture_size = "0 0 1024 1024"
			size = "0 0 100% 100%"
		/>
	</sprite>

	<!-- ================================  ================================ -->
	<!-- Tooltips -->
	<!-- ================================  ================================ -->
	<sprite name="BackgroundEditorTooltip">
		<image
			backcolor="darkbrown"
			size="0 0 100% 100%"
		/>
		<image backcolor="gold" size="0 0 100% 1"/>
		<image backcolor="gold" size="0 100%-1 100% 100%"/>
		<image backcolor="gold" size="0 0 1 100%"/>
		<image backcolor="gold" size="100%-1 0 100% 100%"/>
	</sprite>

	<!-- ================================  ================================ -->
	<!-- Menu -->
	<!-- ================================  ================================ -->

	<sprite name="horizontalThinBorder">
		<image
			texture="editor/border/line_horiz.png"
			texture_size="0 0 64 4"
		/>
	</sprite>

	<!-- ================================  ================================ -->
	<!-- Icon -->
	<!-- ================================  ================================ -->
	<sprite name="snIconPortrait">
		<image texture="editor/icons/bkg/portrait_black.dds" size="0 0 100% 100%"/>
	</sprite>

	<sprite name="snIconPortraitOver">
		<effect add_color="42 42 42 0"/>
		<image texture="editor/icons/bkg/portrait_black.dds" size="0 0 100% 100%"/>
	</sprite>

	<sprite name="snIconPortraitDisabled">
		<effect grayscale=""/>
		<image texture="editor/icons/bkg/portrait_black.dds" size="0 0 100% 100%"/>
	</sprite>

	<sprite name="BackgroundTranslucent">
		<image backcolor="0 0 0 85"
			size="0 0 100% 100%"
		/>
	</sprite>

	<sprite name="ModernPanelThinBorder">
		<image texture="global/modern/background.png"
			texture_size="0 0 512 512"
			size="4 4 100%-4 100%-4"
		/>

		<!-- sides -->
		<image texture="editor/border/line_horiz.png"
			texture_size="0 0 64 4"
			size="4 0 100%-4 4"
		/>
		<image texture="editor/border/line_vert.png"
			texture_size="0 0 4 64"
			size="100%-4 4 100% 100%-4"
		/>
		<image texture="editor/border/line_horiz.png"
			texture_size="0 0 64 4"
			size="4 100%-4 100%-4 100%"
		/>
		<image texture="editor/border/line_vert.png"
			texture_size="0 0 4 64"
			size="0 4 4 100%-4"
		/>

		<!-- corners -->
		<image
			texture="editor/border/line_corner_top_right.png"
			texture_size="0 0 4 4"
			size="100%-4 0 100% 4"
		/>
		<image texture="editor/border/line_corner_bottom_right.png"
			texture_size="0 0 4 4"
			size="100%-4 100%-4 100% 100%"
		/>
		<image texture="editor/border/line_corner_bottom_left.png"
			texture_size="0 0 4 4"
			size="0 100%-4 4 100%"
		/>
		<image texture="editor/border/line_corner_top_left.png"
			texture_size="0 0 4 4"
			size="0 0 4 4"
		/>
	</sprite>

	<!-- Map Panel -->
	<sprite name="mapPanel">
		<!-- background -->
		<image backcolor = "gold"/>

		<image texture = "global/modern/background.png"
			texture_size = "0 0 1024 1024"
			size = "2 2 100%-2 100%-2"
		/>
	</sprite>

	<sprite name="bandbox">
		<image backcolor="black" size="0 0 100% 1"/>
		<image backcolor="black" size="100%-1 0 100% 100%"/>
		<image backcolor="black" size="0 100%-1 100% 100%"/>
		<image backcolor="black" size="0 0 1 100%"/>
		<image backcolor="white" size="1 1 100%-1 2"/>
		<image backcolor="white" size="100%-2 1 100%-1 100%-1"/>
		<image backcolor="white" size="1 100%-2 100%-1 100%-1"/>
		<image backcolor="white" size="1 1 2 100%-1"/>
	</sprite>
</sprites>
