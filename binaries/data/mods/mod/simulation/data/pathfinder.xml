<?xml version="1.0" encoding="utf-8"?>
<Pathfinder>
  <!-- Sets limit on the number of same turns moves we will process -->
  <!-- Setting the value to 0 disable this functionality -->
  <MaxSameTurnMoves>20</MaxSameTurnMoves>

  <Pushing>
    <!-- Units push each other if they are within 'clearance * radius' meters. -->
    <!-- Setting the value to 0 disables unit pushing entirely. -->
    <!-- Note that values above 2-3 are likely to start behaving weirdly. -->
    <!-- You can also tweaks extensions below. -->
    <Radius>1.4</Radius>

    <!-- Actual pushing radius for non-moving units is: -->
    <!-- Clearance * PushingRadius + StaticPushExtension -->
    <!-- This mostly controls the maximum unit density-->
    <StaticExtension>0.5</StaticExtension>

    <!-- Actual pushing radius for moving units is: -->
    <!-- Clearance * PushingRadius + MovingPushExtension -->
    <MovingExtension>4.0</MovingExtension>

    <!-- Pushing force depends on the distance between units. -->
    <!-- The maximum pushing distance (maxDist) is: -->
    <!--   maxDist = combinedClearance * Radius + Extension -->
    <!-- Where combinedClearance is the sum of unit clearances with correction. -->
    <!-- -->
    <!-- The force tapers off linearly from maxDist down to combinedSpread, -->
    <!-- where combinedSpread = maxDist * Spread. -->
    <!-- -->
    <!-- Within combinedSpread distance, units receive maximum pushing force. -->
    <!-- At maxDist distance, units receive zero force. -->
    <!-- In between, force scales linearly. -->
    <!-- -->
    <!-- A Spread value of 0 means force always decreases linearly from -->
    <!-- maxDist to 0. A Spread value of 1 means force is always at maximum -->
    <!-- within maxDist (full on/off). -->
    <!-- -->
    <!-- For realistic crowd behavior, Spread should be around 0.4-0.6, -->
    <!-- giving a good balance between smooth movement and strong repulsion -->
    <StaticSpread>0.9</StaticSpread>
    <MovingSpread>0.4</MovingSpread>

    <!-- After the combined pushing force of all neighboring units is calculated, -->
    <!-- if the value is below this number, treat it as effectively zero. -->
    <!-- This nullifies very small pushes, and makes things look and behave nicer. -->
    <!-- NB: This impacts the pushing max distance. -->
    <!-- NB: If this is 0.25 or above, then pairs of units will overlap -->
    <!-- See MAX_DISTANCE_FACTOR in CCmpUnitMotion_System.cpp for details.-->
    <MinimalForce>0.2</MinimalForce>

    <!-- Multiplier for the pushing pressure units exert on each other. -->
    <!-- Pushing pressure is a measure of 'how pushed' a unit is. -->
    <!-- It will slow down units and make movement more realistic, but slower. -->
    <PressureStrength>0.5</PressureStrength>
    <!-- This controls the decay rate, 1 never decays, 0 decays entirely every turn. -->
    <PressureDecay>0.6</PressureDecay>

    <!-- Solid units (PhysicalBody/Solid: ships, the largest elephants) collide as their footprint, and -->
    <!-- two of them that touch while closing on each other are stopped rigidly. -->
    <!-- Two solid units soft push each other from further off than the ones above, so they are turned -->
    <!-- around by the soft push before they touch, and fewer of their contacts are rigid stops. -->
    <!-- A solid unit and a non-solid one keep the pushing radius above. -->
    <!-- Actual pushing radius between two non-moving solid units is: -->
    <!-- Radius * PushingRadius + SolidStaticExtension -->
    <SolidStaticExtension>1.5</SolidStaticExtension>

    <!-- Actual pushing radius between two solid units, either moving, is: -->
    <!-- Radius * PushingRadius + SolidMovingExtension -->
    <SolidMovingExtension>12</SolidMovingExtension>

    <!-- How much harder two solid units soft push each other, on top of the push growing with their size. -->
    <!-- A stronger push turns them around from closer, so it allows shorter extensions above. A solid unit -->
    <!-- and a non-solid one keep the plain push: it goes both ways, and would hold the solid unit off the -->
    <!-- crowd as much as the crowd off it. -->
    <SolidPushScale>1</SolidPushScale>
    <!-- Two touching solid units closing slower than this (in m/s) are left to the push rather than -->
    <!-- stopped, so a herd walking shoulder to shoulder isn't halted at every brush. Never more than -->
    <!-- half of what the push moves them apart by in a turn, whatever this says. -->
    <SolidBrushSpeed>3</SolidBrushSpeed>
    <!-- A soft push landing off a solid unit's centre also turns it. This is the share of the physical -->
    <!-- spin it gets: the push eases overlaps apart every turn, and a full spin keeps twisting a unit on -->
    <!-- an order against its own steering. 1 is the physical answer, 0 never turns it. -->
    <SolidPushSpin>0.35</SolidPushSpin>
    <!-- Two overlapping solid units are moved apart by this share of how deep they overlap every 0.2 s, on -->
    <!-- top of the push, however they got there. 0 leaves overlaps to the push alone. -->
    <SolidOverlapCorrection>0.2</SolidOverlapCorrection>

  </Pushing>

  <PassabilityClasses>

    <!-- Unit pathfinding classes: -->
    <default>
      <Obstructions>pathfinding</Obstructions>
      <MaxWaterDepth>2</MaxWaterDepth>
      <MaxTerrainSlope>1.0</MaxTerrainSlope>
      <Clearance>0.8</Clearance>
    </default>
    <large>
      <Obstructions>pathfinding</Obstructions>
      <MaxWaterDepth>2</MaxWaterDepth>
      <MaxTerrainSlope>1.0</MaxTerrainSlope>
      <Clearance>3.0</Clearance>
    </large>
    <ship>
      <Obstructions>pathfinding</Obstructions>
      <MinWaterDepth>1</MinWaterDepth>
      <Clearance>10.0</Clearance>
    </ship>
    <ship-small>
      <Obstructions>pathfinding</Obstructions>
      <MinWaterDepth>1</MinWaterDepth>
      <Clearance>3.0</Clearance>
    </ship-small>

    <!--
    Building construction classes:
    * Land is used for most buildings, which must be away
        from water and not on cliffs or mountains.
    * Shore is used for docks, which must be near water and
        land, yet shallow enough for builders to approach.
    -->
    <building-land>
      <Obstructions>foundation</Obstructions>
      <MaxWaterDepth>0</MaxWaterDepth>
      <MinShoreDistance>4.0</MinShoreDistance>
      <MaxTerrainSlope>1.0</MaxTerrainSlope>
    </building-land>
    <building-shore>
      <Obstructions>foundation</Obstructions>
      <MaxShoreDistance>8.0</MaxShoreDistance>
      <MaxTerrainSlope>1.25</MaxTerrainSlope>
    </building-shore>

    <!--
    Unrestricted: only off-world limits.

    Default-terrain-only: used by the AI, for wall-building
        placement and for territory influence growth.
        It must be kept in sync with "default".
    Ship-terrain-only: used by the AI.
        It must be kept in sync with "ship" and "ship-small".
    -->
    <unrestricted>
      <Obstructions>none</Obstructions>
    </unrestricted>
    <default-terrain-only>
      <Obstructions>none</Obstructions>
      <MaxWaterDepth>2</MaxWaterDepth>
      <MaxTerrainSlope>1.0</MaxTerrainSlope>
    </default-terrain-only>
    <ship-terrain-only>
      <Obstructions>none</Obstructions>
      <MinWaterDepth>1</MinWaterDepth>
    </ship-terrain-only>

  </PassabilityClasses>
</Pathfinder>
