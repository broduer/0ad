<?xml version="1.0" encoding="utf-8"?>

<!--
	modiomod-r29 — gui/modmod/modmod.xml
	Revision: 1.0.1 (internal rev 2)
	Last revision: 2026-09-10 23:52 CET

	Change notes:
	- rev1 (2026-09-10, Claude on behalf of Grautvornix): First version of this
	  override shipped by this mod. Based character-for-character on the
	  actual current 0.29-dev trunk gui/modmod/modmod.xml (0AD-SVN/binaries/
	  data/mods/mod/gui/modmod/modmod.xml), with three changes:

	  1. Added name="modmod" to the page's root object (stock has no name
	     there) so modmod.js can hang this page's onTick off it for the
	     Check for Updates feature — the same thing modio.xml's root object
	     ("modio") is already named for.
	  2. Added "checkUpdatesButton", in the row already used by
	     toggleModButton/visitWebButton ("384 100%-80 564 100%-52" — same
	     180px-wide/4px-gap pattern used elsewhere on this page). No inline
	     <action> on it: it is wired in modmod.js's init(), matching this
	     file's existing style, where every other button here is wired in JS
	     rather than XML. "message"'s left edge moved from 466 to 568 (568 =
	     564 + 4px gap) to make room; nothing else about it changed, and no
	     other existing object was moved or resized.
	  3. Bug fix (see modmod.js's header for the full explanation): removed
	     the <action on="Press">/<action on="TextEdit"> attributes from
	     modGenericFilter, negateFilter and modCompatibleFilter. Those called
	     displayModLists() as if it were a global, which cannot work now that
	     this page loads modmod.js as an ES module (module-scoped functions
	     aren't visible to inline XML actions) — this is the actual, still-
	     reproducing cause of the "Filter compatible" errors Grautvornix reported.
	     The three controls are now wired in modmod.js's init() instead,
	     using the exact idiom already used for every other control on this
	     page.
	- rev2 (2026-09-10, Claude on behalf of Grautvornix): Per Grautvornix's
	  in-game test feedback (reported on real 0.28, applied here identically
	  since 0.29 shares the same layout request), moved "checkUpdatesButton"
	  out of the MOD-SPECIFIC BUTTONS row and into the main bottom BUTTONS
	  row, between "Help" and "Download Mods" ("vertically aligned with the
	  buttons on the right between help and download mods"). To make room
	  without touching downloadButton/saveConfigurationButton/startButton,
	  quitButton/cancelButton and Help were both shifted 184px (180px width
	  + 4px gap) further left: quitButton/cancelButton now
	  "100%-1116 100%-44 100%-936 100%-16" (was "100%-932...100%-752"), Help
	  now "100%-932 100%-44 100%-752 100%-16" (was "100%-748...100%-568"),
	  and checkUpdatesButton now occupies Help's old slot,
	  "100%-748 100%-44 100%-568 100%-16". downloadButton,
	  saveConfigurationButton and startButton are untouched, and it is still
	  wired in modmod.js's init() (no inline <action>, per this file's
	  existing style). The MOD-SPECIFIC BUTTONS row's toggleModButton/
	  visitWebButton are untouched, and "message" reverts to its original
	  stock position ("466 100%-78 100%-15 100%-52"). Also see modmod.js's
	  rev2 notes: this release also fixes a crash
	  (Engine.ModIoGetDownloadProgress() returning null) reported in the
	  same 0.28 test, which would equally have affected 0.29 since the
	  affected code was identical in both builds.
-->

<objects>

	<script directory="gui/common/"/>
	<script module="gui/modmod/modmod.js"/>

	<object name="modmod" type="image" style="ModernWindow">

		<!-- Page Title -->
		<object style="ModernLabelText" type="text" size="50%-128 4 50%+128 36">
			<translatableAttribute id="caption">Modifications</translatableAttribute>
		</object>

		<!-- Filter Panel -->
		<object size="0 40 350 64">
			<object name="modGenericFilter"
				type="input"
				style="ModernInput"
				size="16 0 176 100%"
			>
				<translatableAttribute id="placeholder_text">Filter</translatableAttribute>
			</object>

			<!-- Checkboxes -->
			<object name="negateFilter"
				type="checkbox"
				checked="false"
				style="ModernTickBox"
				size="186 0 206 100%"
			>
			</object>
			<object type="text" size="208 0 100% 100%" text_align="left" textcolor="white">
				<translatableAttribute id="caption">Negate</translatableAttribute>
			</object>
		</object>

		<object size = "100%-275 40 100%-20 64">
			<object name="modCompatibleFilter"
						type="checkbox"
						checked="false"
						style="ModernTickBox"
						size="16 0 36 100%"
					>
				</object>
				<object type="text" size="40 0 100% 100%" text_align="left" textcolor="white">
					<translatableAttribute id="caption">Filter compatible</translatableAttribute>
				</object>
		</object>

		<object
			name="globalModDescription"
			type="text"
			size="350 32 100%-16 69"
			textcolor="180 180 180"
			text_align="left"
			text_valign="center"
		>
			<translatableAttribute id="caption">Description</translatableAttribute>
		</object>

		<!-- Available Mods Wrapper -->
		<object size="16 66 100%-15 62%">

			<object style="ModernLabelText" type="text" size="0 5 100% 25">
				<translatableAttribute id="caption">Available Mods</translatableAttribute>
			</object>

			<object name="modsDisabledList"
				type="olist"
				style="ModernSortedList"
				sortable="true"
				selected_column="name"
				selected_column_order="1"
				size="0 25 100%-2 100%"
				font="sans-stroke-13"
				auto_scroll="true"
			>
				<!-- List headers -->
				<!-- Keep the column names in sync with the property names of mods -->
				<column id="name" textcolor="255 255 255" width="10%">
					<translatableAttribute id="heading">Name</translatableAttribute>
				</column>
				<column id="version" textcolor="255 255 255" width="7%">
					<translatableAttribute id="heading">Version</translatableAttribute>
				</column>
				<column id="folder" textcolor="255 255 255" width="13%">
					<translatableAttribute id="heading">(Folder)</translatableAttribute>
				</column>
				<column id="label" textcolor="255 255 255" width="26%">
					<translatableAttribute id="heading">Mod Label</translatableAttribute>
				</column>
				<column id="dependencies" textcolor="255 255 255" width="20%">
					<translatableAttribute id="heading">Dependencies</translatableAttribute>
				</column>
				<column id="url" textcolor="255 255 255" width="24%">
					<translatableAttribute id="heading">Website</translatableAttribute>
				</column>
			</object>
		</object>

		<!-- Enabled Mods Wrapper -->
		<object size="16 62% 100%-15 100%-84">

			<object style="ModernLabelText" type="text" size="0 5 100% 25">
				<translatableAttribute id="caption">Enabled Mods</translatableAttribute>
				<translatableAttribute id="tooltip">Enabled mods are loaded from top to bottom. Mods loaded later might overwrite settings of mods loaded earlier. It is advisable to have more complex mods loaded last. Use the arrows on the right to change the loading order.</translatableAttribute>
			</object>

			<object name="modsEnabledList"
				style="ModernSortedList"
				type="olist"
				size="0 25 100%-32-2-2 100%"
				font="sans-stroke-13"
				tooltip_style="pgToolTip"
				auto_scroll="true"
			>
				<!-- List headers -->
				<column id="name" textcolor="255 255 255" width="10%">
					<translatableAttribute id="heading">Name</translatableAttribute>
				</column>
				<column id="version" textcolor="255 255 255" width="7%">
					<translatableAttribute id="heading">Version</translatableAttribute>
				</column>
				<column id="folder" textcolor="255 255 255" width="13%">
					<translatableAttribute id="heading">(Folder)</translatableAttribute>
				</column>
				<column id="label" textcolor="255 255 255" width="26%">
					<translatableAttribute id="heading">Mod Label</translatableAttribute>
				</column>
				<column id="dependencies" textcolor="255 255 255" width="20%">
					<translatableAttribute id="heading">Dependencies</translatableAttribute>
				</column>
				<column id="url" textcolor="255 255 255" width="24%">
					<translatableAttribute id="heading">Website</translatableAttribute>
				</column>
			</object>

			<object
				name="enabledModUp"
				type="button"
				style="ModernButtonRed"
				size="100%-32-2 23+4 100%-2 23+32+4"
				enabled="false"
				sprite="ModernArrowUpRed"
				sprite_pressed="ModernArrowUpRed"
				sprite_over="ModernArrowUpRedBright"
				sprite_disabled="ModernArrowUpGrey"
			>
				<translatableAttribute id="tooltip">Change the order in which mods are launched. This should match the mods dependencies.</translatableAttribute>
			</object>
			<object
				name="enabledModDown"
				type="button"
				style="ModernButtonRed"
				size="100%-32-2 100%-32-4 100%-2 100%-4"
				enabled="false"
				sprite="ModernArrowDownRed"
				sprite_pressed="ModernArrowDownRed"
				sprite_over="ModernArrowDownRedBright"
				sprite_disabled="ModernArrowDownGrey"
			>
				<translatableAttribute id="tooltip">Change the order in which mods are launched. This should match the mods dependencies.</translatableAttribute>
			</object>
		</object>

		<!-- MOD-SPECIFIC BUTTONS -->
		<object name="toggleModButton" type="button" style="ModernButtonRed" size="16 100%-80 196 100%-52" enabled="false"/>
		<object name="visitWebButton" type="button" style="ModernButtonRed" size="200 100%-80 380 100%-52" enabled="false">
			<translatableAttribute id="caption">Visit Website</translatableAttribute>
		</object>

		<!-- Message: reverted to its original stock position (rev2 moved checkUpdatesButton down into the main BUTTONS row below). -->
		<object name="message" type="text" size="466 100%-78 100%-15 100%-52" text_align="left" textcolor="white"/>

		<!-- BUTTONS -->
		<object name="quitButton" type="button" style="ModernButtonRed" size="100%-1116 100%-44 100%-936 100%-16">
			<translatableAttribute id="caption">Quit</translatableAttribute>
		</object>

		<object name="cancelButton" type="button" style="ModernButtonRed" size="100%-1116 100%-44 100%-936 100%-16" hotkey="cancel">
			<translatableAttribute id="caption">Cancel</translatableAttribute>
		</object>

		<object type="button" style="ModernButtonRed" size="100%-932 100%-44 100%-752 100%-16">
			<translatableAttribute id="caption">Help</translatableAttribute>
		  <action on="Press">Engine.OpenChildPage("page_modhelp.xml");</action>
		</object>

		<!-- Check for Updates: added by modiomod. Queries mod.io directly from this screen and recolours the lists below (yellow = update available), without opening the separate mod.io downloader. Wired in modmod.js's init(); see checkForUpdates() there. Moved here in rev2, between Help and Download Mods, per Grautvornix's request. -->
		<object name="checkUpdatesButton" type="button" style="ModernButtonRed" size="100%-748 100%-44 100%-568 100%-16">
			<translatableAttribute id="caption">Check for Updates</translatableAttribute>
		</object>

		<object name="downloadButton" type="button" style="ModernButtonRed" size="100%-564 100%-44 100%-384 100%-16">
			<translatableAttribute id="caption">Download Mods</translatableAttribute>
		</object>

		<object name="saveConfigurationButton" type="button" style="ModernButtonRed" size="100%-380 100%-44 100%-200 100%-16">
			<translatableAttribute id="caption">Save Configuration</translatableAttribute>
		</object>

		<object name="startButton" type="button" style="ModernButtonRed" size="100%-196 100%-44 100%-16 100%-16">
			<translatableAttribute id="caption">Save and Restart</translatableAttribute>
		</object>
	</object>
</objects>
