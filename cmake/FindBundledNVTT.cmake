# Locate nvidia-texture-tools bundled version
# This module provides the following Imported Targets:
#	nvtt::nvtt
# These variables may optionally be set to help this module find the correct files:
#	NVTT_LIBRARY
#	NVTT_INCLUDE_DIR
#	BUNDLED_NVTT_DIR

if(UNIX)
	set(BUNDLED_NVTT_SEARCH_PATH ${CMAKE_SOURCE_DIR}/libraries/source/nvtt)
else()
	set(BUNDLED_NVTT_SEARCH_PATH ${0AD_EXT_LIBDIR}/nvtt)
endif()

find_path(BUNDLED_NVTT_INCLUDE_DIR nvtt/nvtt.h
	PATHS
		${BUNDLED_NVTT_DIR}
		${BUNDLED_NVTT_SEARCH_PATH}
	PATH_SUFFIXES
		include
	NO_DEFAULT_PATH
)

find_library(BUNDLED_NVTT_LIBRARY
	NAMES
		nvtt
	PATHS
		${BUNDLED_NVTT_DIR}
		${BUNDLED_NVTT_SEARCH_PATH}
	PATH_SUFFIXES
		lib/
	DOC "Mozilla SpiderMonkey JavaScript Engine Library(Bundled)"
	NO_DEFAULT_PATH
)
find_library(BUNDLED_NVTT_LIBRARY_DEBUG
	NAMES
		nvttd
	PATHS
		${BUNDLED_NVTT_DIR}
		${BUNDLED_NVTT_SEARCH_PATH}
	PATH_SUFFIXES
		lib/
	NO_DEFAULT_PATH
)
find_library(BUNDLED_NVTT_NVCORE
	NAMES
		nvcore
	PATHS
		${BUNDLED_NVTT_DIR}
		${BUNDLED_NVTT_SEARCH_PATH}
	PATH_SUFFIXES
		lib/
	NO_DEFAULT_PATH
)
mark_as_advanced(BUNDLED_NVTT_LIBRARY_DEBUG BUNDLED_NVTT_NVCORE)

find_package_handle_standard_args(BundledNVTT
	REQUIRED_VARS
		BUNDLED_NVTT_LIBRARY
		BUNDLED_NVTT_INCLUDE_DIR
	VERSION_VAR
		BundledNVTT_VERSION
)

if (BundledNVTT_FOUND AND NOT TARGET BdlNVTT::BdlNVTT)
	add_library(BdlNVTT::BdlNVTT UNKNOWN IMPORTED)
	target_link_libraries(BdlNVTT::BdlNVTT
		INTERFACE
			${BUNDLED_NVTT_NVCORE}
	)
	set_target_properties(BdlNVTT::BdlNVTT
		PROPERTIES
			IMPORTED_LOCATION ${BUNDLED_NVTT_LIBRARY}
			INTERFACE_INCLUDE_DIRECTORIES ${BUNDLED_NVTT_INCLUDE_DIR}
			IMPORTED_LINK_INTERFACE_LANGUAGES_RELEASE "CXX"
			IMPORTED_LOCATION_RELEASE "${BUNDLED_NVTT_LIBRARY}"
	)
	set_property(TARGET BdlNVTT::BdlNVTT APPEND PROPERTY
		IMPORTED_CONFIGURATIONS RELEASE
	)
	if(EXISTS "${BUNDLED_NVTT_LIBRARY_DEBUG}")
		set_property(TARGET BdlNVTT::BdlNVTT APPEND PROPERTY
			IMPORTED_CONFIGURATIONS DEBUG
		)
		set_target_properties(BdlNVTT::BdlNVTT
			PROPERTIES
				IMPORTED_LINK_INTERFACE_LANGUAGES_DEBUG "CXX"
				IMPORTED_LOCATION_DEBUG "${BUNDLED_NVTT_LIBRARY_DEBUG}"
				MAP_IMPORTED_CONFIG_MINSIZEREL Release
				MAP_IMPORTED_CONFIG_RELWITHDEBINFO Release
		)
	endif()
endif()

